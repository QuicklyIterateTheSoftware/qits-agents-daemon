<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-agents-daemon-reactor</artifactId>
        <version>2026.1125.201021</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>qits-agents-daemon</artifactId>
    <packaging>quarkus</packaging>

    <!-- The agent container's process: a Quarkus command-mode app compiled to a native binary that
         is the `qits/agent` image's entrypoint. It provisions the wrapper checkout, follows every
         commit on main, pushes the agent's branches, and keeps the one Claude session — talking to
         qits-agents-service only through its REST doors, with the agent's own token.

         Deps as in qits-projects-daemon: quarkus-arc (CDI + command mode), quarkus-vertx (a managed
         Vertx for the loopback hook webhook, and its JsonObject), the harness library. HTTP out is
         the JDK's HttpClient. No JAX-RS, no Jackson in main. -->

    <dependencies>
        <dependency>
            <groupId>eu.wohlben.qits</groupId>
            <artifactId>qits-agents-daemon-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>eu.wohlben.qits</groupId>
            <artifactId>qits-commands</artifactId>
        </dependency>
        <dependency>
            <!-- AgentLaunchService and the `project.agent` surface. -->
            <groupId>eu.wohlben.qits</groupId>
            <artifactId>qits-coding-agents</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-vertx</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- contracts/: the consumer pacts against qits-agents-service and qits-projects-service. -->
            <groupId>eu.wohlben.qits</groupId>
            <artifactId>qits-pact-consumer</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>au.com.dius.pact.consumer</groupId>
            <artifactId>junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>eu.wohlben.qits</groupId>
            <artifactId>qits-agents-golden-masters</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>eu.wohlben.qits</groupId>
            <artifactId>qits-projects-golden-masters</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- The harness library's ForeignPty reaches java.lang.foreign downcalls. -->
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- GraalVM native build: `-Dnative`. The Dockerfile's build stage runs
             `-pl agents-daemon -am package -Dnative`. -->
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>
